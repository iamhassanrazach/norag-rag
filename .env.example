# Copy this file to .env and fill it in.

# Which AI model answers questions and builds concept maps.
# Any OpenAI-compatible server works. Leave LLM_URL empty to use Google Gemini.
LLM_URL=
LLM_API_KEY=your_key_here
# Several keys separated by commas are rotated when one hits the rate limit (429).
LLM_MODEL=gemini-2.5-flash-lite

# Gemini keys: https://aistudio.google.com/app/api-keys
# (the old names GOOGLE_API_KEY, GOOGLE_API_KEYS and GEMINI_MODEL still work)

# Estimated price in USD per million tokens, used for the cost shown in traces. Check them for your model.
# LLM_PRICE_IN=0.10
# LLM_PRICE_OUT=0.40

# Privacy and traces
# PII_REDACTION=1
# PII_NAMES=Jane Doe,John Roe
# TRACE_RETENTION_DAYS=30
